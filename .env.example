# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE (Client & Server)
# Obtenha estas credenciais no painel do seu projeto Supabase (Project Settings > API)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# PROVEDORES DE DADOS DE EMPRESAS (Opcional - BusinessSearchService)
# Para produção com dados reais de empresas brasileiras:
# GOOGLE_PLACES_API_KEY="your-google-places-key"
# BRASIL_API_TOKEN="optional-brasil-api-token"

# MERCADO PAGO INTEGRATION (Server-Side Secrets)
# Obtenha em: https://www.mercadopago.com.br/developers > Suas integrações > Credenciais de produção / teste
# O Access Token deve ser mantido estritamente seguro no servidor e NUNCA exposto no frontend.
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADO_PAGO_PUBLIC_KEY="APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADO_PAGO_WEBHOOK_SECRET="your-mercadopago-webhook-secret"

# CONTA PROPRIETÁRIO / OWNER (Opcional - Padrão: jknetoe@gmail.com)
OWNER_EMAIL="jknetoe@gmail.com"
VITE_OWNER_EMAIL="jknetoe@gmail.com"

